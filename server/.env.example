# Copy this file to server/.env and fill in real values. server/.env is git-ignored.
# Keys with "__" map to nested configuration (JwtSettings__Key -> JwtSettings:Key).

# --- JWT --- (use a long random string, at least 32 characters)
JwtSettings__Key=replace-with-a-long-random-secret-of-at-least-32-characters

# --- SQL Server ---
ConnectionStrings__DefaultConnection="Server=localhost;Database=CozyGen;Trusted_Connection=True;TrustServerCertificate=True;"

# --- Redis --- (docker-compose uses REDIS_PASSWORD; the API uses the connection string)
REDIS_PASSWORD=change-me
RedisSettings__ConnectionString="localhost:6379,password=change-me"

# --- Kafka ---
KafkaConfig__BootstrapServers=localhost:9092
KafkaConfig__TopicName=order-notifications

# --- AI (Groq) ---
GROQ_API_KEY=your-groq-api-key

# --- Contact form email (EmailController) ---
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-address@gmail.com
Email__SmtpPassword=your-app-password

# --- Error emails from NLog ---
NLOG_SMTP_USER=your-address@gmail.com
NLOG_SMTP_PASSWORD=your-app-password
NLOG_EMAIL_TO=you@example.com
