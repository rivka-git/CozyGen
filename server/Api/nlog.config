<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog-AspNetCore.txt">

	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
		<add assembly="NLog.MailKit"/>
	</extensions>

	<!-- the targets to write to -->
	<targets>
		<!-- File Target for own log messages with extra web details using some ASP.NET core renderers -->
		<target xsi:type="File" name="mylogfile"
			fileName="${basedir}/../../../../logs/logger-${shortdate}.log"
				layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}|${callsite}" />
		<target name="email" xsi:type="Mail"
				subject="Sent From The Logger!"
				to="${environment:NLOG_EMAIL_TO}"
				from="${environment:NLOG_SMTP_USER}"
				body="${message}${newline}"
				smtpUserName="${environment:NLOG_SMTP_USER}"
				secureSocketOption="Auto"
				skipCertificateValidation="true"
				smtpAuthentication="Basic"
				enableSsl="false"
				smtpPassword="${environment:NLOG_SMTP_PASSWORD}"
				smtpServer ="smtp.gmail.com"
				smtpPort="465"
				timeout="100000"
/>
	</targets>
	<!-- rules to map from logger name to target -->
	<rules>

		<!--Skip non-critical Microsoft logs and so log only own logs (BlackHole) -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<logger name="*" minlevel="Info" writeTo="mylogfile" />
		<logger name="*" minlevel="Error" writeTo="email" />

	</rules>
<ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</nlog>
