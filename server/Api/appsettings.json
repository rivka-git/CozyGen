{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CozyGen;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "DefaultTTLInMinutes": 10
  },
  "JwtSettings": {
    "Issuer": "CozyGen.Api",
    "Audience": "CozyGen.Client",
    "ExpiryMinutes": 120
  },
  "KafkaConfig": {
    "BootstrapServers": "localhost:9092",
    "TopicName": "order-notifications"
  }
}
